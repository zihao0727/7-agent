# ── Anthropic（旧版 CLI 模式使用）──────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── DeepSeek（FastAPI 后端使用，必填）──────────────────────────────
DEEPSEEK_API_KEY=sk-...
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ── 可选配置 ──────────────────────────────────────────────────────
# Tavily 搜索 API Key（启用 WebSearchTool 需要）
TAVILY_API_KEY=tvly-...

# Agent 循环最大迭代次数（默认 20）
# MAX_ITERATIONS=20
