ANTHROPIC_API_KEY=replace-with-anthropic-api-key

DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

KIMI_API_KEY=replace-with-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

SEVNX_API_KEY=replace-with-sevnx-api-key
SEVNX_BASE_URL=https://www.sevnx.one/v1
SEVNX_MODEL=gpt-5.5

NEXT_PUBLIC_DEEPSEEK_MODEL=deepseek-v4-flash
NEXT_PUBLIC_KIMI_MODEL=kimi-k2.6
NEXT_PUBLIC_SEVNX_MODEL=gpt-5.5

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_DATABASE=7_agent

SMTP_HOST=smtp.163.com
SMTP_PORT=465
SMTP_SENDER=replace-with-smtp-sender
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_SUBJECT=SevnX平台注册验证码

TAVILY_API_KEY=replace-with-tavily-api-key

REDIS_URL=redis://localhost:6379/0

LARK_CLI_BINARY=lark-cli
LARK_CLI_TIMEOUT_SECONDS=60
LARK_CLI_CONFIG_DIR=data/lark-cli-config

