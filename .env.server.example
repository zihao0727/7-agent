API_PORT=6868
WEB_PORT=7878
APP_ENV=production

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-generated-fernet-key

# Public HTTPS URLs behind the reverse proxy.
PUBLIC_API_URL=https://api.example.com
CORS_ORIGINS=["https://app.example.com"]

MYSQL_ROOT_PASSWORD=replace-with-a-long-random-root-password
MYSQL_PASSWORD=replace-with-a-long-random-app-password

DEEPSEEK_API_KEY=replace-with-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

KIMI_API_KEY=replace-with-kimi-api-key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=kimi-k2.6

SEVNX_API_KEY=replace-with-sevnx-api-key
SEVNX_BASE_URL=https://www.sevnx.one/v1
SEVNX_MODEL=gpt-5.5

TAVILY_API_KEY=replace-with-tavily-api-key

SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SENDER=replace-with-smtp-sender
SMTP_PASSWORD=replace-with-smtp-app-password
SMTP_SUBJECT=Agent7 注册验证码

API_PUBLIC_BASE_URL=https://api.example.com
LARK_EXECUTION_MODE=client
CLIENT_RUNTIME_TIMEOUT_SECONDS=120
