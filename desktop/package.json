{
  "name": "agent7-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Agent7 desktop runtime",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "@larksuite/cli": "^1.0.85",
    "npm": "^11.6.2",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "cn.agent7.desktop",
    "productName": "Agent7",
    "asar": true,
    "files": [
      "*.cjs",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "config.example.json",
        "to": "config.example.json"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
